{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/school/create", "destination": "/api/onboarding/actions?action=createSchool" },
    { "source": "/api/classes/create", "destination": "/api/onboarding/actions?action=createClass" },
    { "source": "/api/invites/create", "destination": "/api/onboarding/actions?action=createInvite" },
    { "source": "/api/invites/manage", "destination": "/api/onboarding/actions?action=manageInvites" },
    { "source": "/api/invites/redeem", "destination": "/api/onboarding/actions?action=redeemInvite" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
