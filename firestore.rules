// ==========================================================================
// EDVIA Firestore Security Rules
// ==========================================================================
// These are the LAST line of defence, not the only one. EDVIA enforces
// authorization three times:
//
//   1. Application layer  — routes and services act on the authenticated
//                           user's real profile (src/app/SchoolContext).
//   2. Tool layer         — api/_lib/tools/execute.ts re-derives identity
//                           from a verified Firebase ID token and checks
//                           role + school + ownership on every AI call.
//   3. These rules        — which bound what the browser can read directly,
//                           regardless of what the app code asks for.
//
// The Admin SDK (all of api/) bypasses these rules by design; that path is
// covered by layer 2. Everything below governs the client SDK only.
//
// PRINCIPLE: belonging to a school does NOT grant access to that school's
// students. Access is granted by a specific relationship — you are the
// student, you are their parent, you teach their class, or you are the
// principal. Anything broader is a data leak waiting to be demonstrated.
// ==========================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- identity helpers -------------------------------------------------
    // Every helper reads the SAME users/{uid} document. Rules cache identical
    // get() calls within one evaluation, so this costs one document read per
    // request, not one per helper.

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return profile().get('role', '');
    }

    function mySchoolId() {
      return profile().get('schoolId', '');
    }

    // Students this caller may see as an individual: themself (student), or
    // their linked children (parent). Empty for staff, who are scoped by
    // class instead.
    function myStudentIds() {
      return myRole() == 'student'
        ? [profile().get('studentId', '__none__')]
        : (myRole() == 'parent' ? profile().get('linkedStudentIds', []) : []);
    }

    // Classes whose shared content this caller may see. Written server-side
    // only, by api/onboarding/redeem-invite.ts: a teacher's assigned classes,
    // a student's own class, a parent's children's classes.
    function myClassIds() {
      return profile().get('classIds', []);
    }

    // Verified school management.
    //
    // Reads principalOfSchoolId — written ONLY by
    // api/onboarding/redeem-invite.ts against a single-use, school-issued
    // principal code — and NOT `role`. `role` is chosen by the client on the
    // signup screen, so gating school-wide reads on it would let anyone
    // register as "Principal", pick a school and read the whole roster.
    // The grant is excluded from every client-writable path below.
    function isPrincipalOf(schoolId) {
      return myRole() == 'principal'
        && mySchoolId() == schoolId
        && profile().get('principalOfSchoolId', '__none__') == schoolId;
    }

    function inMySchool() {
      return resource.data.get('schoolId', '__none__') == mySchoolId();
    }

    // ---- users ------------------------------------------------------------
    // `role` can never change after account creation — no client-side role
    // escalation, ever. `schoolId` may move from "" to a value exactly once,
    // during onboarding; after that it is locked, so a compromised client
    // still cannot reassign itself to another school.
    //
    // studentId / linkedStudentIds / teacherId / principalOfSchoolId /
    // classIds are EXCLUDED from what a client update may touch, and from
    // what a create may set at all. Those fields are precisely what the AI
    // tool layer trusts to decide whose records a request may read. If a
    // client could set them, a signed-in student could point studentId at a
    // classmate and read their attendance through EDVIA. They are written
    // only server-side, after validating a single-use invite code.
    function unchanged(field) {
      return !(field in request.resource.data) == !(field in resource.data)
        && (!(field in resource.data) || request.resource.data[field] == resource.data[field]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (request.resource.data.schoolId == resource.data.schoolId || resource.data.schoolId == '')
        && unchanged('studentId')
        && unchanged('linkedStudentIds')
        && unchanged('teacherId')
        && unchanged('principalOfSchoolId')
        && unchanged('classIds');
      allow create: if isSignedIn() && request.auth.uid == userId
        && !('studentId' in request.resource.data)
        && !('linkedStudentIds' in request.resource.data)
        && !('teacherId' in request.resource.data)
        && !('principalOfSchoolId' in request.resource.data)
        && !('classIds' in request.resource.data);
      allow delete: if false;

      // Per-user read/bookmark state for shared content. Lives under the
      // user's own profile so ownership is structural.
      match /readState/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ---- schools ----------------------------------------------------------
    // Readable by any signed-in user because the onboarding school picker
    // runs before the user has a schoolId. Name and location only — schools
    // hold no personal data.
    //
    // Writes stay closed even for the school's own administrator. Schools are
    // created by api/school/create.ts, which mints the creator's
    // principalOfSchoolId grant in the SAME transaction; a client-writable
    // schools collection would let an account create a school document and
    // then look for a way to claim it.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- invite codes -----------------------------------------------------
    // Never client-readable: a listable code collection would let anyone
    // browse for unused codes instead of needing the one their school gave
    // them. Redemption runs through the Admin SDK, which bypasses rules, so
    // this stays fully closed.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // ---- join tokens (QR + typed code) ------------------------------------
    // Fully closed in both directions, which is the point of the whole
    // design. `invites` holds the SHA-256 of each join secret; a client that
    // could read this collection could not redeem anything (the hash is not
    // the secret), but it could enumerate every school's live invitations,
    // their expiry, and which children have parent links outstanding. That is
    // a roster leak by another name.
    //
    // `inviteCodeIndex` maps a typed human code to an invite. It is closed
    // for the stronger reason: those codes ARE credentials, and a readable
    // index is a list of working ones.
    //
    // Everything legitimate goes through the Admin SDK:
    //   api/invites/create.ts   mint      (staff only, per-kind authorization)
    //   api/invites/preview.ts  describe  (unauthenticated, minimal fields)
    //   api/invites/redeem.ts   consume   (transactional, single source of
    //                                      truth for every grant)
    //   api/invites/manage.ts   list/revoke
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    match /inviteCodeIndex/{humanCode} {
      allow read, write: if false;
    }

    // ---- students ---------------------------------------------------------
    // The collection this rule set exists for. A student sees only their own
    // record; a parent only their linked children; a teacher only students in
    // classes they teach; a principal only their own school.
    match /students/{studentId} {
      allow read: if isSignedIn() && inMySchool() && (
        isPrincipalOf(resource.data.schoolId)
        || studentId in myStudentIds()
        // Staff ONLY. myClassIds() contains a STUDENT's own class and a
        // PARENT's children's classes too, so an unguarded class branch let
        // every student read every classmate's record — name, roll number,
        // section. Caught by "student CANNOT read a classmate" in
        // scripts/testRules.mjs, which is why that assertion exists.
        || (myRole() in ['teacher', 'principal']
            && resource.data.get('classId', '__none__') in myClassIds())
      );
      allow write: if false;
    }

    // ---- classes ----------------------------------------------------------
    match /classes/{classId} {
      allow read: if isSignedIn() && inMySchool() && (
        isPrincipalOf(resource.data.schoolId)
        || classId in myClassIds()
      );
      allow write: if false;
    }

    // ---- attendance -------------------------------------------------------
    // Same relationship test as students. Writes are server-only: the only
    // paths that create attendance are api/attendance/mark.ts and the
    // markAttendance AI tool, both of which re-verify the teacher's class
    // assignment with the Admin SDK.
    match /attendance/{recordId} {
      allow read: if isSignedIn() && inMySchool() && (
        isPrincipalOf(resource.data.schoolId)
        // Students and parents are scoped by the STUDENT relationship...
        || resource.data.get('studentId', '__none__') in myStudentIds()
        // ...and only staff by the class one, for the same reason as
        // /students above: a student's own classIds contains their class.
        || (myRole() in ['teacher', 'principal']
            && resource.data.get('classId', '__none__') in myClassIds())
      );
      allow write: if false;
    }

    // ---- class-scoped academic content ------------------------------------
    // Assignments, exams and the timetable belong to a class, not a student.
    // Anyone attached to that class may read them; the principal may read
    // their whole school's.
    function canReadClassContent() {
      return isSignedIn() && inMySchool() && (
        isPrincipalOf(resource.data.schoolId)
        || resource.data.get('classId', '__none__') in myClassIds()
      );
    }

    match /assignments/{id} {
      allow read: if canReadClassContent();
      allow write: if false;
    }

    match /exams/{id} {
      allow read: if canReadClassContent();
      allow write: if false;
    }

    // ---- exam results (marks) ---------------------------------------------
    // The most sensitive academic record the school holds, so the test is the
    // STUDENT relationship, not the class one: a classmate attached to the
    // same class may read the class's exam PAPER (above) but must never read
    // another student's MARK for it.
    //
    //   student   → their own results
    //   parent    → their linked children's results
    //   teacher   → results for classes they teach (they enter them)
    //   principal → their own school, verified grant only
    //
    // Writes are server-only. The only two paths that create a result are
    // api/grades/record.ts and the recordExamResult AI tool, both of which
    // re-verify the teacher's class assignment, the exam's ownership and the
    // 0..maxScore range with the Admin SDK. A client-writable marks
    // collection would let a student rewrite their own report card.
    match /examResults/{id} {
      allow read: if isSignedIn() && inMySchool() && (
        isPrincipalOf(resource.data.schoolId)
        || resource.data.get('studentId', '__none__') in myStudentIds()
        || (myRole() in ['teacher', 'principal']
            && resource.data.get('classId', '__none__') in myClassIds())
      );
      allow write: if false;
    }

    match /classSubjects/{id} {
      allow read: if canReadClassContent();
      allow write: if false;
    }

    // ---- school-wide, non-personal content --------------------------------
    // Notices, study resources and the policy handbook carry no personal
    // data and are meant for everyone at the school.
    match /notices/{id} {
      allow read: if isSignedIn() && inMySchool();
      allow write: if false;
    }

    match /resources/{id} {
      allow read: if isSignedIn() && inMySchool();
      allow write: if false;
    }

    match /policies/{schoolId}/sections/{sectionId} {
      allow read: if isSignedIn() && schoolId == mySchoolId();
      allow write: if false;
    }

    // Calendar events are dates and titles, no PII. Teachers and principals
    // may post them for their own school; every other write stays server-side.
    match /calendarEvents/{id} {
      allow read: if isSignedIn() && inMySchool();
      allow create: if isSignedIn() && myRole() in ['teacher', 'principal']
        && request.resource.data.schoolId == mySchoolId();
      allow update, delete: if false;
    }

    // ---- analytics --------------------------------------------------------
    match /schoolAnalytics/{schoolId} {
      allow read: if isSignedIn() && isPrincipalOf(schoolId);
      allow write: if false;
    }

    // ---- personal collections ---------------------------------------------
    // Notifications are created server-side; the owner may flip their own
    // `read` flag and nothing else.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Support requests: visible to whoever raised them, and to the staff
    // member they were routed to — otherwise a teacher could never see a
    // parent's call-back request in their own app.
    match /supportRequests/{id} {
      allow read: if isSignedIn() && (
        resource.data.requestedBy == request.auth.uid
        || resource.data.get('routedToUid', '__none__') == request.auth.uid
        || (isPrincipalOf(resource.data.get('schoolId', '__none__'))
            && resource.data.get('recipientType', '') == 'management')
      );
      // Status changes go through api/support/update-status.ts, which does
      // the authorization, the forward-only legality check and the write in
      // ONE transaction. A client-writable status field would let the routed
      // teacher mark a request resolved without the transition ever being
      // audited — and would let a REQUESTER mark their own escalation
      // resolved, which is the one person whose opinion the status is not
      // recording.
      allow write: if false;
    }

    // ---- server-only --------------------------------------------------------
    // Conversation memory would leak tool-call internals and allow memory
    // tampering; audit logs must not be readable or forgeable by the very
    // accounts they record. Both are Admin-SDK only, even for the owner.
    match /conversationMemory/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /auditLogs/{id} {
      allow read, write: if false;
    }

    // Rate-limit counters. Server-only in both directions: a client that
    // could read them would learn its remaining budget, and one that could
    // write them could reset its own counter.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ---- deny by default ----------------------------------------------------
    // Any collection added later is closed until it is explicitly considered.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
