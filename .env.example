# ==========================================================================
# EDVIA — environment configuration
# ==========================================================================
# Copy to .env.local and fill in. Nothing here is optional in production:
# EDVIA has no mock-data fallback. Without Firebase it will tell you it
# isn't connected rather than showing invented school records.
# ==========================================================================

# --------------------------------------------------------------------------
# CLIENT (VITE_-prefixed — these ARE bundled into the browser)
# --------------------------------------------------------------------------
# Firebase web config is public by design: it identifies the project, it
# does not authorise anything. Access is controlled by Firebase Auth and
# firestore.rules, both of which are enforced server-side.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned upload (profile photos, scanned documents).
# The upload preset must be unsigned and folder-restricted; the API SECRET
# must never appear here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Set to "true" to point local development at the Firebase Emulator Suite.
# Never set this in a deployed environment.
VITE_USE_FIREBASE_EMULATOR=

# NOTE: there is deliberately NO VITE_GEMINI_API_KEY.
# Gemini is called exclusively from server routes under api/. A
# VITE_-prefixed key would be inlined into the JavaScript bundle and
# readable by anyone who opens devtools. Voice mode reaches Gemini Live
# using a single-use ephemeral token minted per session by
# api/ai/voice-session.ts, so the long-lived key never leaves the server.

# --------------------------------------------------------------------------
# SERVER ONLY — set these in your hosting provider's environment settings.
# Vite never inlines non-VITE_ variables, so the browser cannot read them.
# --------------------------------------------------------------------------

# Gemini (server-side orchestration + Live voice)
GEMINI_API_KEY=
# Model ids are configuration. Defaults are generally-available models;
# override to move to a newer family without a code change.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
GEMINI_TEMPERATURE=0.4

# Firebase Admin SDK service account
# (Firebase Console > Project Settings > Service Accounts > Generate key)
# FIREBASE_PRIVATE_KEY keeps its literal \n sequences; the app un-escapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Restricts api/ai/document.ts to fetching files from your own Cloudinary
# account rather than any URL a client supplies.
CLOUDINARY_CLOUD_NAME=

# --------------------------------------------------------------------------
# Live AI evaluation only (npm run eval) — never needed in production
# --------------------------------------------------------------------------
EDVIA_EVAL_BASE_URL=
EDVIA_FIREBASE_API_KEY=
EDVIA_EVAL_STUDENT_EMAIL=
EDVIA_EVAL_STUDENT_PASSWORD=
EDVIA_EVAL_PARENT_EMAIL=
EDVIA_EVAL_PARENT_PASSWORD=
EDVIA_EVAL_TEACHER_EMAIL=
EDVIA_EVAL_TEACHER_PASSWORD=
EDVIA_EVAL_PRINCIPAL_EMAIL=
EDVIA_EVAL_PRINCIPAL_PASSWORD=
